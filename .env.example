# --- Backend (faultcapsule) ---
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
SERPAPI_API_KEY=
GEMMA_MODEL=google/gemma-4-E2B-it
OLLAMA_MODEL=hf.co/unsloth/gemma-4-E2B-it-GGUF:Q4_K_M
# Force a provider: openrouter | aistudio | ollama | mock (empty = auto)
GEMMA_PROVIDER=
# Point at any OpenAI-compatible endpoint (e.g. vLLM on NVIDIA GPU)
# OPENAI_BASE_URL=http://localhost:8000/v1

# --- Dashboard (Vite) ---
# Omit this variable to use the built-in synthetic demo adapter.
# The offline guard only permits loopback backend hosts while Network OFF.
VITE_API_BASE_URL=http://127.0.0.1:8000
